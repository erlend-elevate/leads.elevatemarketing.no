# Elevate Reporting — miljøvariabler
# Kopier til .env (lokalt) og legg inn i Vercel-prosjektet (produksjon).
# ALDRI sjekk inn ekte verdier.

# Neon Postgres, EU-region (GDPR). Connection string fra Neon-dashbordet.
DATABASE_URL=

# Windsor.ai → Settings → API Keys. Krever betalt Windsor-plan.
WINDSOR_API_KEY=

# Resend (e-postutsendelse). Avsenderdomene: rapport.elevatemarketing.no
RESEND_API_KEY=

# Anthropic (AI-sammendrag)
ANTHROPIC_API_KEY=
# Modell-ID, f.eks. claude-sonnet-5 — verifiser gjeldende ID mot docs.claude.com
ANTHROPIC_MODEL=

# Basis-URL for portal-lenker og PDF-print
APP_URL=https://rapport.elevatemarketing.no

# Tilfeldig streng, 32+ tegn. Beskytter /api/cron/tick.
# Generer: openssl rand -base64 32
CRON_SECRET=

# iron-session-hemmelighet, 32+ tegn
SESSION_SECRET=

# bcrypt-hash av admin-passordet
ADMIN_PASSWORD_HASH=

# Dit interne feilvarsler går
INTERNAL_ALERT_EMAIL=erlend@elevatemarketing.no

# Valgfri fallback for PDF-generering (connectOverCDP) hvis chromium i
# Vercel-funksjonen blir et problem
BROWSERLESS_URL=
